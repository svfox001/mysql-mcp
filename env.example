# This file is generated by scripts/generate-env.py as .env - don't edit .env
# by hand unless you know what you're doing. This env.example documents every
# variable it produces, for reference.

# --- Addressing ---
# "ip" (self-signed cert via Caddy's `tls internal`) or "domain" (automatic
# Let's Encrypt). Set by --addressing-mode in generate-env.py.
ADDRESSING_MODE=ip
# The bare IP or the domain name, matching ADDRESSING_MODE.
SITE_ADDRESS=203.0.113.10

# --- MySQL connection (the ai_readonly user created by generate-grants.py) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_readonly
MYSQL_PASS=change-me
MYSQL_DB=your_database

# --- mcp-server-mysql fixed settings (do not change) ---
# Without IS_REMOTE_MCP=true, the server silently defaults to stdio mode and
# never opens a port - see docs/TROUBLESHOOTING.md.
IS_REMOTE_MCP=true
ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
MCP_PORT=3000

# --- Auth ---
# Login password for the gateway's built-in --password auth mode.
AUTH_PASSWORD=change-me
# Shared bearer secret: authproxy attaches this when forwarding authenticated
# requests to mcp; mcp checks incoming requests carry it. Both containers must
# have the same value, which is why scripts/rotate-secrets.py restarts both
# when rotating this one.
REMOTE_SECRET_KEY=change-me
# The public URL clients will use - used to construct correct OAuth
# issuer/redirect-URI values. Must match SITE_ADDRESS.
EXTERNAL_URL=https://203.0.113.10
# CIDR range authproxy trusts for X-Forwarded-* headers coming from edge.
# The default covers Docker's standard bridge network ranges (172.16.0.0/12);
# adjust if your Docker network uses a custom subnet.
TRUSTED_PROXIES=172.16.0.0/12
# Internal port authproxy listens on inside the Docker network.
AUTHPROXY_PORT=8080

# --- Branding (rendered into edge/rendered/login.html and authorize.html) ---
APP_NAME=MySQL MCP Gateway
